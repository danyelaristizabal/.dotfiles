<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.danyelaristizabal.dotfiles.always-on</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/dotfiles-always-on</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>/var/log/dotfiles-always-on.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/dotfiles-always-on.log</string>
</dict>
</plist>
