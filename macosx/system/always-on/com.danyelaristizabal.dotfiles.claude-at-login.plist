<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Opens the Claude app in the background at login, so remote sessions can reach this Mac -->
    <key>Label</key>
    <string>com.danyelaristizabal.dotfiles.claude-at-login</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/open</string>
        <string>-g</string>
        <string>-a</string>
        <string>Claude</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
